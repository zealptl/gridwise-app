{
  "openapi": "3.0.3",
  "info": {
    "title": "F1 Fantasy Prediction Engine API",
    "description": "Runs ML prediction models and team optimization algorithms. Predicts finishing positions, fantasy points, and constructs optimal teams under budget constraints.",
    "version": "1.0.0"
  },
  "paths": {
    "/predictFinishingOrder": {
      "post": {
        "operationId": "predictFinishingOrder",
        "summary": "Predict race finishing order using gathered features",
        "description": "Takes all gathered data (practice pace, historical patterns, weather, qualifying) and runs the gradient-boosted ranking model to predict race finishing positions with confidence intervals.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["race_id"],
                "properties": {
                  "race_id": { "type": "string", "description": "Race identifier (e.g., '2026-R8-spain')" },
                  "features_json": { "type": "string", "description": "JSON string of all gathered features: practice pace, qualifying times, weather, historical data" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Predicted finishing order with confidence intervals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "predictions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "driver": { "type": "string" },
                          "predicted_position": { "type": "number" },
                          "confidence_interval_low": { "type": "integer" },
                          "confidence_interval_high": { "type": "integer" },
                          "dnf_probability": { "type": "number" },
                          "predicted_points": { "type": "number", "description": "WDC points (25, 18, 15, etc.)" }
                        }
                      }
                    },
                    "model_confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
                    "data_completeness": { "type": "string", "description": "Which sessions were available for prediction" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/predictFantasyPoints": {
      "post": {
        "operationId": "predictFantasyPoints",
        "summary": "Predict F1 Fantasy points for specific drivers and constructors",
        "description": "Converts predicted race/qualifying/sprint positions into expected F1 Fantasy points, including positions gained, overtakes, fastest lap probability, and constructor bonuses.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["race_id", "drivers", "constructors"],
                "properties": {
                  "race_id": { "type": "string" },
                  "drivers": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of driver IDs to predict for"
                  },
                  "constructors": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of constructor IDs to predict for"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fantasy point predictions per driver and constructor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "driver_predictions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "driver_id": { "type": "string" },
                          "name": { "type": "string" },
                          "expected_points": { "type": "number" },
                          "points_range_low": { "type": "number" },
                          "points_range_high": { "type": "number" },
                          "breakdown": {
                            "type": "object",
                            "properties": {
                              "qualifying_points": { "type": "number" },
                              "race_position_points": { "type": "number" },
                              "positions_gained_points": { "type": "number" },
                              "overtake_points": { "type": "number" },
                              "fastest_lap_probability": { "type": "number" },
                              "dnf_risk_points": { "type": "number" }
                            }
                          },
                          "points_per_million": { "type": "number", "description": "Value metric: expected points / current price" }
                        }
                      }
                    },
                    "constructor_predictions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "constructor_id": { "type": "string" },
                          "name": { "type": "string" },
                          "expected_points": { "type": "number" },
                          "points_per_million": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/optimizeTeam": {
      "post": {
        "operationId": "optimizeTeam",
        "summary": "Find the optimal team composition within budget constraints",
        "description": "Searches across all valid team combinations (5 drivers + 2 constructors within $100M budget) to find the team with the highest expected fantasy points. Supports multiple optimization modes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["budget"],
                "properties": {
                  "budget": { "type": "number", "description": "Available budget in millions (max $100M)" },
                  "mode": {
                    "type": "string",
                    "enum": ["balanced", "safe", "aggressive", "value"],
                    "description": "Balanced: max expected points. Safe: max floor (minimize downside). Aggressive: max ceiling (maximize upside). Value: max points-per-million."
                  },
                  "must_include": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Driver/constructor IDs that must be in the team (e.g., user doesn't want to transfer them out)"
                  },
                  "must_exclude": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Driver/constructor IDs to exclude"
                  },
                  "active_chip": {
                    "type": "string",
                    "enum": ["none", "limitless", "wildcard", "no_negative", "triple_boost", "autopilot", "final_fix"],
                    "description": "If a chip is active this week, it affects optimization (e.g., Limitless removes budget cap)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Optimal team recommendation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recommended_team": {
                      "type": "object",
                      "properties": {
                        "drivers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": { "type": "string" },
                              "name": { "type": "string" },
                              "price": { "type": "number" },
                              "expected_points": { "type": "number" },
                              "reasoning": { "type": "string" }
                            }
                          }
                        },
                        "constructors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": { "type": "string" },
                              "name": { "type": "string" },
                              "price": { "type": "number" },
                              "expected_points": { "type": "number" }
                            }
                          }
                        },
                        "drs_boost_recommendation": { "type": "string" },
                        "total_cost": { "type": "number" },
                        "budget_remaining": { "type": "number" },
                        "total_expected_points": { "type": "number" },
                        "total_points_range": { "type": "string", "description": "e.g., '85 - 142 pts (90% CI)'" }
                      }
                    },
                    "alternative_teams": {
                      "type": "array",
                      "description": "2-3 alternative team compositions with different risk profiles"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recommendChipTiming": {
      "post": {
        "operationId": "recommendChipTiming",
        "summary": "Recommend when to use remaining power-up chips",
        "description": "Analyzes the remaining race calendar, track characteristics, and predictability to recommend optimal chip deployment. Limitless works best at predictable races, No Negative at high-DNF circuits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id"],
                "properties": {
                  "user_id": { "type": "string" },
                  "remaining_chips": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chip timing recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chip": { "type": "string" },
                      "recommended_round": { "type": "integer" },
                      "race_name": { "type": "string" },
                      "reasoning": { "type": "string" },
                      "expected_points_uplift": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
