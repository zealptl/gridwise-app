{
  "openapi": "3.0.3",
  "info": {
    "title": "F1 Fantasy Team Validation API",
    "description": "Validates proposed fantasy teams against the rules engine and manages team submission. Connects to the user's custom validation engine.",
    "version": "1.0.0"
  },
  "paths": {
    "/validateTeam": {
      "post": {
        "operationId": "validateTeam",
        "summary": "Validate a proposed team against F1 Fantasy rules",
        "description": "Checks that the proposed team meets all constraints: budget cap ($100M), correct roster size (5 drivers + 2 constructors), no duplicate entries, and valid transfer count. Returns pass/fail with specific reasons.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["drivers", "constructors", "budget_used"],
                "properties": {
                  "drivers": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 5,
                    "maxItems": 5,
                    "description": "Exactly 5 driver IDs"
                  },
                  "constructors": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "Exactly 2 constructor IDs"
                  },
                  "budget_used": { "type": "number", "description": "Total cost of proposed team" },
                  "drs_boost_driver": { "type": "string", "description": "Driver ID receiving DRS Boost" },
                  "active_chip": { "type": "string", "description": "Chip being played this weekend, if any" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": { "type": "boolean" },
                    "errors": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "List of validation errors, empty if valid"
                    },
                    "warnings": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Non-blocking warnings (e.g., tight budget, risky picks)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/checkTransferPenalties": {
      "post": {
        "operationId": "checkTransferPenalties",
        "summary": "Calculate transfer penalties for proposed changes",
        "description": "Compares the proposed team against the user's current team and calculates how many transfers are needed and the point penalty for extra transfers beyond the 2 free ones.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "proposed_drivers", "proposed_constructors"],
                "properties": {
                  "user_id": { "type": "string" },
                  "proposed_drivers": { "type": "array", "items": { "type": "string" } },
                  "proposed_constructors": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transfer penalty calculation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transfers_needed": { "type": "integer" },
                    "free_transfers_available": { "type": "integer" },
                    "extra_transfers": { "type": "integer" },
                    "penalty_points": { "type": "integer", "description": "Extra transfers × -10 points" },
                    "drivers_in": { "type": "array", "items": { "type": "string" } },
                    "drivers_out": { "type": "array", "items": { "type": "string" } },
                    "constructors_in": { "type": "array", "items": { "type": "string" } },
                    "constructors_out": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/submitTeamToEngine": {
      "post": {
        "operationId": "submitTeamToEngine",
        "summary": "Submit the finalized team to the user's validation engine",
        "description": "Sends the confirmed team to the user's custom validation and tracking engine. Only call this after the user has confirmed the recommendation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id", "team"],
                "properties": {
                  "user_id": { "type": "string" },
                  "team": {
                    "type": "object",
                    "properties": {
                      "drivers": { "type": "array", "items": { "type": "string" } },
                      "constructors": { "type": "array", "items": { "type": "string" } },
                      "drs_boost_driver": { "type": "string" },
                      "active_chip": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "submission_id": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
