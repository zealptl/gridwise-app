{
  "openapi": "3.0.3",
  "info": {
    "title": "F1 Fantasy Data API",
    "description": "Interfaces with the official F1 Fantasy API and the user's custom team tracking API to get prices, team composition, budget, chips, and transfer data.",
    "version": "1.0.0"
  },
  "paths": {
    "/getCurrentPrices": {
      "get": {
        "operationId": "getCurrentPrices",
        "summary": "Get current fantasy prices for all drivers and constructors",
        "description": "Returns the current F1 Fantasy price for every driver and constructor, plus their price change since season start. Essential for budget-constrained team optimization.",
        "parameters": [
          {
            "name": "season",
            "in": "query",
            "required": false,
            "description": "Season year, defaults to current season (2026)",
            "schema": { "type": "string", "default": "2026" }
          }
        ],
        "responses": {
          "200": {
            "description": "Driver and constructor prices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "drivers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "team": { "type": "string" },
                          "price": { "type": "number", "description": "Current price in millions" },
                          "season_start_price": { "type": "number" },
                          "price_change": { "type": "number", "description": "Change since season start" }
                        }
                      }
                    },
                    "constructors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "price": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getUserTeam": {
      "get": {
        "operationId": "getUserTeam",
        "summary": "Get the user's current fantasy team composition",
        "description": "Returns the user's currently selected 5 drivers and 2 constructors, their DRS Boost selection, remaining budget, and available chips. This is the starting point for recommending changes.",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "description": "The user's unique identifier in your team tracking system",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User's current team",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "drivers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "price_purchased": { "type": "number" },
                          "current_price": { "type": "number" }
                        }
                      }
                    },
                    "constructors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "price_purchased": { "type": "number" }
                        }
                      }
                    },
                    "drs_boost_driver": { "type": "string" },
                    "budget_remaining": { "type": "number" },
                    "transfers_used": { "type": "integer" },
                    "transfers_available": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getAvailableChips": {
      "get": {
        "operationId": "getAvailableChips",
        "summary": "Get the user's remaining power-up chips",
        "description": "Returns which of the 6 chips (Wildcard, Limitless, No Negative, 3x Boost, Autopilot, Final Fix) the user still has available this season.",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Available chips",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wildcard": { "type": "boolean" },
                    "limitless": { "type": "boolean" },
                    "no_negative": { "type": "boolean" },
                    "triple_boost": { "type": "boolean" },
                    "autopilot": { "type": "boolean" },
                    "final_fix": { "type": "boolean" },
                    "chips_used_history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "chip": { "type": "string" },
                          "used_at_round": { "type": "integer" },
                          "points_gained": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getPriceChangeProjections": {
      "get": {
        "operationId": "getPriceChangeProjections",
        "summary": "Get predicted price changes for drivers and constructors",
        "description": "Returns projected price movements based on transfer activity and recent performance. Buy drivers about to rise, sell those about to drop to grow your budget.",
        "responses": {
          "200": {
            "description": "Price change projections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "current_price": { "type": "number" },
                      "projected_change": { "type": "number" },
                      "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
                      "reason": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
