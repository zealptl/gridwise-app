{
  "openapi": "3.0.3",
  "info": {
    "title": "F1 Live Session Data API",
    "description": "Fetches real-time and recent F1 session data from OpenF1 API including lap times, telemetry, weather, stints, and race control messages.",
    "version": "1.0.0"
  },
  "paths": {
    "/getLatestSession": {
      "get": {
        "operationId": "getLatestSession",
        "summary": "Get the latest or current F1 session",
        "description": "Returns information about the most recent F1 session (FP1, FP2, FP3, Qualifying, Sprint, or Race). Use this first to get the session_key needed for other calls.",
        "responses": {
          "200": {
            "description": "Session information including session_key, session_type, meeting_key, date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_key": { "type": "integer", "description": "Unique session identifier to use in other API calls" },
                    "session_type": { "type": "string", "description": "Type: Practice, Qualifying, Sprint, Race" },
                    "meeting_key": { "type": "integer" },
                    "date_start": { "type": "string", "format": "date-time" },
                    "circuit_short_name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getLapTimes": {
      "get": {
        "operationId": "getLapTimes",
        "summary": "Get lap timing data for a driver in a session",
        "description": "Returns detailed lap-by-lap timing data including sector times, lap duration, and pit in/out laps. Essential for pace analysis and predicting race finishing positions.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "description": "The session identifier. Use 'latest' for the current session or a specific numeric key.",
            "schema": { "type": "string" }
          },
          {
            "name": "driver_number",
            "in": "query",
            "required": false,
            "description": "Driver's car number (e.g., 1 for Verstappen, 4 for Norris). If omitted, returns data for all drivers.",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of lap timing records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver_number": { "type": "integer" },
                      "lap_number": { "type": "integer" },
                      "lap_duration": { "type": "number", "description": "Lap time in seconds" },
                      "duration_sector_1": { "type": "number" },
                      "duration_sector_2": { "type": "number" },
                      "duration_sector_3": { "type": "number" },
                      "is_pit_out_lap": { "type": "boolean" },
                      "st_speed": { "type": "number", "description": "Speed trap speed in km/h" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getCarTelemetry": {
      "get": {
        "operationId": "getCarTelemetry",
        "summary": "Get high-frequency car telemetry data",
        "description": "Returns car data at ~3.7Hz including speed, throttle, brake, DRS status, RPM, and gear. Use for detailed pace analysis and identifying car strengths/weaknesses.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "driver_number",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of telemetry data points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "speed": { "type": "integer", "description": "Speed in km/h" },
                      "throttle": { "type": "integer", "description": "Throttle percentage 0-100" },
                      "brake": { "type": "integer", "description": "Brake applied: 0 or 100" },
                      "drs": { "type": "integer", "description": "DRS status code" },
                      "n_gear": { "type": "integer" },
                      "rpm": { "type": "integer" },
                      "date": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getSessionWeather": {
      "get": {
        "operationId": "getSessionWeather",
        "summary": "Get track-side weather data during a session",
        "description": "Returns real-time weather conditions at the circuit including air/track temperature, humidity, wind, pressure, and rainfall. Critical for predicting wet-weather performance shifts.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of weather readings during the session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "air_temperature": { "type": "number" },
                      "track_temperature": { "type": "number" },
                      "humidity": { "type": "number" },
                      "pressure": { "type": "number" },
                      "wind_speed": { "type": "number" },
                      "wind_direction": { "type": "integer" },
                      "rainfall": { "type": "boolean" },
                      "date": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getStints": {
      "get": {
        "operationId": "getStints",
        "summary": "Get tyre stint data for a driver",
        "description": "Returns tyre compound used, stint start/end laps, and tyre age. Essential for understanding degradation patterns and predicting race strategy.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "driver_number",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of stint records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver_number": { "type": "integer" },
                      "compound": { "type": "string", "description": "SOFT, MEDIUM, HARD, INTERMEDIATE, WET" },
                      "lap_start": { "type": "integer" },
                      "lap_end": { "type": "integer" },
                      "stint_number": { "type": "integer" },
                      "tyre_age_at_start": { "type": "integer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getRaceControlMessages": {
      "get": {
        "operationId": "getRaceControlMessages",
        "summary": "Get race control messages (flags, penalties, safety car)",
        "description": "Returns official race control messages including flag states, penalties, investigations, safety car deployments, and VSC. Important for tracking grid penalties and incidents.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of race control messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string", "description": "Flag, SafetyCar, Drs, etc." },
                      "message": { "type": "string" },
                      "driver_number": { "type": "integer" },
                      "flag": { "type": "string" },
                      "date": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/getPositions": {
      "get": {
        "operationId": "getPositions",
        "summary": "Get driver position standings during a session",
        "description": "Returns the classification/position of each driver during the session. Use after qualifying or race to get final grid and finishing order.",
        "parameters": [
          {
            "name": "session_key",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of position records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver_number": { "type": "integer" },
                      "position": { "type": "integer" },
                      "date": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
